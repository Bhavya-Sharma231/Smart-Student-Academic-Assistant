void BFS(int start)
{
    int visited[50] = {0};
    int queue[50];
    int front = 0, rear = 0;
    int current, i;

    visited[start] = 1;
    queue[rear] = start;
    rear++;

    printf("\n===== BFS STUDY PATH =====\n");

    while(front < rear)
    {
        current = queue[front];
        front++;

        printf("%s\n", topics[current].topic_name);

        for(i = 0; i < topicCount; i++)
        {
            if(graph[current][i] == 1 && visited[i] == 0)
            {
                visited[i] = 1;
                queue[rear] = i;
                rear++;
            }
        }
    }
}
void DFS(int current, int visited[])
{
    int i;

    visited[current] = 1;

    printf("%s\n", topics[current].topic_name);

    for(i = 0; i < topicCount; i++)
    {
        if(graph[current][i] == 1 && visited[i] == 0)
        {
            DFS(i, visited);
        }
    }
}
