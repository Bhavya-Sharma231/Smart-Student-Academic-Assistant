void sortSubjects(struct subject sub[], int n)
{
    int i, j;

    for(i = 0; i < n - 1; i++)
    {
        for(j = 0; j < n - i - 1; j++)
        {
            if(sub[j].marks < sub[j + 1].marks)
            {
                struct subject temp;

                temp = sub[j];
                sub[j] = sub[j + 1];
                sub[j + 1] = temp;
            }
        }
    }
}

