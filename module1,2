void sortSubjects(struct Subject sub[], int n)
{
    int i, j;

    for(i = 0; i < n - 1; i++)
    {
        for(j = 0; j < n - i - 1; j++)
        {
            if(sub[j].marks < sub[j + 1].marks)
            {
                struct Subject temp;

                temp = sub[j];
                sub[j] = sub[j + 1];
                sub[j + 1] = temp;
            }
        }
    }
}

void searchsubject(struct subject sub[], int n)
{
    char search[50];
    int i, found = 0;

    printf("\nEnter subject to search: ");
    scanf(" %[^\n]", search);

    for(i = 0; i < n; i++)
    {
        if(strcmp(search, sub[i].subname) == 0)
        {
            printf("\nSubject Found!\n");
            printf("Subject: %s\n", sub[i].subname);
            printf("Marks: %.2f\n", sub[i].marks);

            found = 1;
            break;
        }
    }

    if(found == 0)
    {
        printf("\nSubject not found.\n");
    }
}

void weaksubjects(struct subject sub[], int n)
{
    int i;

    printf("\n===== SUBJECTS NEEDING ATTENTION =====\n");

    for(i = 0; i < n; i++)
    {
        if(sub[i].marks < 50)
        {
            printf("%s - %.2f marks\n", sub[i].subname, sub[i].marks);
            printf("Priority: HIGH\n");
        }
        else if(sub[i].marks <= 70)
        {
            printf("%s - %.2f marks\n", sub[i].subname, sub[i].marks);
            printf("Priority: MEDIUM\n");
        }
    }
}

void performanceSummary(struct subject sub[], int n, float average)
{
    int i;
    int highindex = 0, lowindex = 0;
    float highest, lowest;

    highest = sub[0].marks;
    lowest = sub[0].marks;

    for(i = 1; i < n; i++)
    {
        if(sub[i].marks > highest)
        {
            highest = sub[i].marks;
            highindex = i;
        }

        if(sub[i].marks < lowest)
        {
            lowest = sub[i].marks;
            lowindex = i;
        }
    }

    printf("\n===== PERFORMANCE SUMMARY =====\n");

    printf("Average Marks : %.2f\n", average);
    printf("Highest Marks : %.2f\n", highest);
    printf("Strongest Subject : %s\n", sub[highindex].subname);
    printf("Lowest Marks : %.2f\n", lowest);
    printf("Weakest Subject : %s\n", sub[lowindex].subname);
}

