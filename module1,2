void enqueue(struct Assignment *assignment)
{
    if(rear == 9)
    {
        printf("\nQueue is full.\n");
        return;
    }

    if(front == -1)
    {
        front = 0;
    }

    rear++;
    queue[rear] = assignment;

    printf("\nAssignment added to pending queue.\n");
}

void dequeue()
{
    if(front == -1 || front > rear)
    {
        printf("\nQueue is empty.\n");
        return;
    }

    printf("\nProcessing Assignment ID: %d\n",
           queue[front]->assignment_id);

    front++;

    if(front > rear)
    {
        front = -1;
        rear = -1;
    }
}

void calculatePriority(struct Assignment *assignment)
{
    if(assignment->deadline <= 2)
    {
        assignment->priority = 1;
    }
    else if(assignment->deadline <= 5)
    {
        assignment->priority = 2;
    }
    else
    {
        assignment->priority = 3;
    }
}

void priorityEnqueue(struct Assignment *assignment)
{
    int i;

    if(prear == 9)
    {
        printf("\nPriority Queue is full.\n");
        return;
    }

    if(pfront == -1)
    {
        pfront = 0;
    }

    prear++;

    i = prear;

    while(i > pfront &&
          priorityQueue[i - 1]->priority > assignment->priority)
    {
        priorityQueue[i] = priorityQueue[i - 1];
        i--;
    }

    priorityQueue[i] = assignment;

    printf("\nAssignment added to priority queue.\n");
}

void priorityDequeue()
{
    int i;

    if(pfront == -1 || pfront > prear)
    {
        printf("\nPriority Queue is empty.\n");
        return;
    }

    printf("\nProcessing Highest Priority Assignment:\n");
    printf("Assignment ID: %d\n",
           priorityQueue[pfront]->assignment_id);
    printf("Subject: %s\n",
           priorityQueue[pfront]->subject);
    printf("Title: %s\n",
           priorityQueue[pfront]->title);
    printf("Priority: %d\n",
           priorityQueue[pfront]->priority);

    for(i = pfront; i < prear; i++)
    {
        priorityQueue[i] = priorityQueue[i + 1];
    }

    prear--;

    if(prear < pfront)
    {
        pfront = -1;
        prear = -1;
    }
}

void pushTopic()
{
    if(top == 9)
    {
        printf("\nStudy History Stack is full.\n");
        return;
    }

    top++;

    printf("\nEnter studied topic: ");
    scanf(" %[^\n]", studyStack[top]);

    printf("Topic added to study history.\n");
}

void popTopic()
{
    if(top == -1)
    {
        printf("\nNo study history available.\n");
        return;
    }

    printf("\nRecently studied topic: %s\n", studyStack[top]);

    top--;
}

void displayStudyHistory()
{
    int i;

    if(top == -1)
    {
        printf("\nNo study history available.\n");
        return;
    }

    printf("\n===== RECENT STUDY HISTORY =====\n");

    for(i = top; i >= 0; i--)
    {
        printf("%s\n", studyStack[i]);
    }
}
